{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":"vite",
 "buildCommand":"npm run build",
 "outputDirectory":"dist",
 "installCommand":"npm ci",
 "headers":[
  {"source":"/assets/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
  {"source":"/models/anatomy-(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
  {"source":"/models/atlas.json","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
  {"source":"/(og-image.png|anatomy-lab-mark.svg|favicon.svg|site.webmanifest)","headers":[{"key":"Cache-Control","value":"public, max-age=86400, stale-while-revalidate=604800"}]}
 ]
}
